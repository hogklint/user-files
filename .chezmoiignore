# Only autorandr and awesome on laptops
{{ if and (ne .chezmoi.hostname "crown") (ne .chezmoi.hostname "braid") }}
.config/autorandr
.config/awesome
{{ end }}

{{ if and (ne .chezmoi.hostname "crown") (ne .chezmoi.hostname "braid") (ne .chezmoi.hostname "desktop") }}
.Xdefaults
.Xmodmap
.config/kitty
.urlview
.xinitrc
{{ end }}


# No systemd on rebourn
